# Copier ce fichier en .env puis adapter les valeurs. Ne jamais commiter .env.

# Connexion PostgreSQL
DATABASE_URL="postgresql://carview:carview@localhost:5432/carview"

# Better Auth — générer un secret aléatoire : openssl rand -base64 32
BETTER_AUTH_SECRET="remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum"
BETTER_AUTH_URL="http://localhost:3000"

# Stockage local des fichiers (hors du dossier public). En production, remplacer
# l'adaptateur (voir src/server/storage) par un stockage objet (S3, GCS…).
STORAGE_DIR="./storage"

# Notifications par e-mail : non intégrées. Laisser vide tant qu'aucun service
# n'est branché ; l'interface indique alors clairement que l'envoi est indisponible.
EMAIL_PROVIDER=""
